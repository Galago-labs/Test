```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# TypeScript/JavaScript specific
*.js.map
*.tsbuildinfo
.nyc_output/
coverage/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
*.so
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
```